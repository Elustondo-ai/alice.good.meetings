{
  "description": "ASDG guard and public activity logs; review/trust in /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/asdg/scripts/hook.py\" || printf '%s\\n' '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"IMPLEMENTATION BLOCKED\\nASDG guard failed to execute.\"}}'",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/asdg/scripts/hook.py\" log",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/asdg/scripts/hook.py\" log",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/asdg/scripts/hook.py\" log",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$(git rev-parse --show-toplevel)/asdg/scripts/hook.py\" log",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
